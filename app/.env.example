# HoopUp Backend Server API (Takes precedence over Supabase when set)
# e.g. http://127.0.0.1:8787 or http://localhost:3000
VITE_API_BASE_URL=http://127.0.0.1:8787

# Supabase Configuration for Connected Mode (Fallback if VITE_API_BASE_URL is unset)
# Do NOT place secret service-role keys here. Use only the public publishable anon key.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional app port override
# PORT=5173

# Map configuration (optional). MapLibre defaults to a plain background unless a PMTiles archive is configured.
# The Leaflet fallback uses OpenStreetMap public tiles if no provider is set (dev/demo only; see research/RS3_TILES_HOSTING.md).
# VITE_MAP_ENGINE=maplibre     # maplibre (default, also for invalid/unset values) | leaflet (fallback). Runtime: window.__HOOPUP_CONFIG__ or localStorage, same key.
# VITE_MAP_PRESERVE_BUFFER=on # Pixel readback tests only; default OFF, including production. Runtime: window.__HOOPUP_CONFIG__ or localStorage, same key; only 'on' enables it.
# MapLibre uses only PMTiles; without VITE_MAP_PMTILES_URL (or with VITE_MAP_TILES=off), pins use a plain background.
# VITE_MAP_TILES=off            # draw pins only, no tile layer (used by the Android demo)
# VITE_MAP_PMTILES_URL=http://127.0.0.1:8787/tiles/bangkok.pmtiles  # Self-hosted PMTiles vector basemap (highest priority)
# VITE_MAP_PMTILES_FLAVOR=dark  # PMTiles basemap flavor: 'dark' (default) or 'light'
# VITE_PLACES_API_URL=http://127.0.0.1:8787/places # Full endpoint. Default: /places at the absolute PMTiles URL's origin, otherwise app origin.
# VITE_PLACES=off              # Disable nearby places (tests/APK). Default ON, MapLibre only, zoom >= 16.
# Both places keys support window.__HOOPUP_CONFIG__ then localStorage overrides, like the map keys.
# VITE_MAP_TILE_URL=https://tiles.example.com/{z}/{x}/{y}.png
# VITE_MAP_TILE_ATTRIBUTION=&copy; your provider &copy; OpenStreetMap contributors

