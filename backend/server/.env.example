# HoopUp Backend Server Environment Configuration Example
# Copy to .env and adjust values for your environment.

# Server Network Settings
PORT=3000
HOST=127.0.0.1

# Database Configuration (PostgreSQL with hoopup_api role)
DATABASE_URL=postgres://hoopup_api:hoopup_api_dev_password@127.0.0.1:5432/postgres

# Authentication & JWT (HS256)
# Must be >= 32 characters long. Generate with: openssl rand -base64 48
# In production (NODE_ENV=production), known dev/demo secret values are strictly rejected.
JWT_SECRET=super_secret_jwt_passphrase_min_32_bytes_long_12345

# CORS Allow-list (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5199

# Logging Level (debug, info, warn, error)
LOG_LEVEL=info

# Reverse Proxy Trust Configuration
# Default unset = false (ignore X-Forwarded-* headers, use direct socket remoteAddress)
# In production behind a local reverse proxy (Caddy / Nginx), set to proxy IP:
# TRUST_PROXY=127.0.0.1
# Accepts: false/unset, single IP (127.0.0.1), comma-separated IPs/CIDRs (127.0.0.1,10.0.0.0/8), or hop count (e.g. 1).
# Reject at startup: 'true', '*', or empty strings (spoofable).
# TRUST_PROXY=127.0.0.1

# Rate Limiting: Authentication Credential Endpoints (/auth/signup, /auth/login) per IP
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=60000

# Per-Account Login Lock (after N failed attempts for the same email, 429 Retry-After for S seconds)
LOGIN_LOCK_MAX=5
LOGIN_LOCK_WINDOW_MS=900000
LOGIN_LOCK_SECONDS=60

# Rate Limiting: Authenticated Business RPC Calls (/rpc/*) per User (token sub)
# Stricter limit of 20/min automatically applies to hoopup_send_message, hoopup_create_session, and hoopup_report
RPC_RATE_LIMIT_MAX=120
RPC_RATE_LIMIT_WINDOW_MS=60000

# Rate Limiting: Authenticated GET Data Routes (/courts, /messages*, /session_members*, /profiles/*) per User
DATA_RATE_LIMIT_MAX=300
DATA_RATE_LIMIT_WINDOW_MS=60000

# User Status In-Memory Cache TTL (milliseconds) for BAN1 checks
# Enforces account active/banned/deleted status per authenticated request.
# Default 30000 (30 seconds lag bound for moderation actions). Set to 0 to disable caching (query DB every request).
USER_STATUS_CACHE_MS=30000

# Database Connection Pool Timeouts (in milliseconds)
DB_STATEMENT_TIMEOUT_MS=10000
DB_IDLE_TX_TIMEOUT_MS=15000

# Map Tiles Serving (/tiles/:file)
TILES_DIR=./tiles

# Places Dataset and Bbox Route (/places)
PLACES_FILE=./data/places-bangkok.ndjson
PLACES_RATE_LIMIT_MAX=240
PLACES_RATE_LIMIT_WINDOW_MS=60000

# Places Search Route (/places/search)
PLACES_SEARCH_RATE_LIMIT_MAX=120
PLACES_SEARCH_RATE_LIMIT_WINDOW_MS=60000

# OpenID Connect (OIDC) Authentication (Google / LINE)
# Comma-separated list of enabled providers (e.g. google,line). Empty = OIDC feature disabled (routes 404).
OIDC_PROVIDERS=
# Comma-separated list of allowed return_to URLs for start redirect validation.
OIDC_ALLOWED_RETURN_URLS=

# Google Provider Credentials (empty by default; obtained from Google Cloud Console)
OIDC_GOOGLE_CLIENT_ID=
OIDC_GOOGLE_CLIENT_SECRET=
OIDC_GOOGLE_REDIRECT_URI=
# Optional Google overrides (defaults to accounts.google.com endpoints):
# OIDC_GOOGLE_ISSUER=
# OIDC_GOOGLE_AUTH_URL=
# OIDC_GOOGLE_TOKEN_URL=
# OIDC_GOOGLE_JWKS_URL=
# OIDC_GOOGLE_SCOPE=
# OIDC_GOOGLE_TRUST_EMAIL=false
# OIDC_GOOGLE_ALLOW_UNVERIFIED_EMAIL=false

# LINE Provider Credentials (empty by default; obtained from LINE Developers Console)
OIDC_LINE_CLIENT_ID=
OIDC_LINE_CLIENT_SECRET=
OIDC_LINE_REDIRECT_URI=
# Optional LINE overrides (defaults to access.line.me endpoints):
# OIDC_LINE_ISSUER=
# OIDC_LINE_AUTH_URL=
# OIDC_LINE_TOKEN_URL=
# OIDC_LINE_JWKS_URL=
# OIDC_LINE_SCOPE=
# OIDC_LINE_TRUST_EMAIL=false
# OIDC_LINE_ALLOW_UNVERIFIED_EMAIL=true

